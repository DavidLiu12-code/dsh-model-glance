{
  "name": "dsh-model-glance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A refined, lightweight model picker for the DSH composer: search, providers, favorites and recent models, with the real reasoning efforts the selected model advertises.",
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
